# JollyOS configuration. Copy to .env (never commit .env). Every value is optional.

# Demo mode: seeded fictional data, auto-login as the demo user, no setup page.
# Set to "false" to run it for real (first visit shows the owner setup page).
DEMO_MODE=true

# Where runtime data lives (owner credentials, jobs, persona, brief cache).
# The Docker image uses /data; local dev defaults to ./data.
DATA_DIR=./data

# Signs the session cookie. Leave empty to auto-generate one into DATA_DIR
# on first run. Set it explicitly when running more than one instance.
AUTH_SECRET=

# Port for `npm start` / `npm run dev` (Next.js reads PORT).
PORT=3000

# --- AI providers ------------------------------------------------------------
# Which provider answers by default: anthropic | openai | local | demo.
# Empty = auto: the first provider with a key, else the deterministic demo.
LLM_PROVIDER=

# Anthropic (https://console.anthropic.com). Default model: claude-opus-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI. Default model: gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL=

# Local OpenAI-compatible server (LM Studio, Ollama, llama.cpp, vLLM...).
# Example: http://localhost:1234/v1 (LM Studio) or http://localhost:11434/v1 (Ollama).
# This is the ONLY provider that ever sees content tagged local-only, and the
# only job runner a private card may use (no server → the card is Blocked).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# --- Jobs board runners -------------------------------------------------------
# What "Auto" means on the Jobs board: api | cli | local | demo.
# Empty = demo in demo mode, else the first configured of api -> local, else demo.
JOBS_DEFAULT_RUNNER=
# The CLI runner: prefer "codex" or "claude" (empty = codex if installed, else claude),
# the folder it may read and edit, and its time limit in seconds.
JOBS_CLI=
JOBS_CLI_CWD=
JOBS_CLI_TIMEOUT_SEC=1800

# --- Daily Brief ---------------------------------------------------------------
# Comma-separated RSS/Atom feed URLs. Ignored in demo mode (fixtures are used).
# Feeds you accept from the Brief's suggestions are added on top, from
# DATA_DIR/brief-feeds.json. Suggestions are never subscribed by themselves.
BRIEF_FEEDS=

# --- Importing your context --------------------------------------------------
# No settings: uploads go to DATA_DIR/imports/ (git-ignored), every imported item
# is local-only until you change it, and cloud extraction needs a per-batch
# opt-in in the UI. A local model for extraction is the LOCAL_LLM_* server above.
