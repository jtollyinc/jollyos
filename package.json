{
  "name": "jollyos",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted, ADHD-first personal operations dashboard with pluggable modules and privacy-aware AI routing.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrub": "bash scripts/scrub-check.sh",
    "scrub:history": "bash scripts/scrub-check.sh --history",
    "reset-owner": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/reset-owner.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
